# Markets Learning Workbench settings.
# Copy this file to .env (already done for you) and fill in your own keys there.
# Never share .env. It is ignored by git.

# --- Gemini (all AI features) -------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default model. Used when GEMINI_MODEL_FAST / GEMINI_MODEL_SMART are empty.
GEMINI_MODEL=
# Fast/cheap model for bulk tagging. Run scripts\list_gemini_models.py to choose.
GEMINI_MODEL_FAST=
# Stronger model for breakdowns and explanations.
GEMINI_MODEL_SMART=
# The app stops calling Gemini after this many calls per day (Google's day, which resets at midnight Pacific time).
GEMINI_DAILY_CALL_LIMIT=300

# --- Market data keys (all free plans, no card needed) -----------------
# Live US stocks + company news. https://finnhub.io/register
FINNHUB_API_KEY=
# Stock charts + stock backup source. https://twelvedata.com/pricing (Basic, free)
TWELVE_DATA_API_KEY=
# Optional: daily gold/silver/oil history (25 requests/day). https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Optional: steadier crypto backup (CoinGecko Demo key).
COINGECKO_API_KEY=

# --- Server --------------------------------------------------------------
PORT=8000
# true = open the app from your phone on the same Wi-Fi (binds 0.0.0.0). false = this PC only.
LAN_ACCESS=false

# --- Data sources --------------------------------------------------------
# true = allow unofficial sources (Yahoo, ForexFactory) as the LAST fallback, always labelled "Unofficial".
ALLOW_UNOFFICIAL_SOURCES=true
